{
  "info": {
    "_postman_id": "84f020d0-8887-432b-a702-132b77032032",
    "name": "Práctica 3.2 - Enrutamiento y filtrado ILIA",
    "description": "Seis casos obligatorios de Content-Based Router y Message Filter en el endpoint existente de ILIA. La colección asume un token Sanctum en la variable secreta token; no se incluye ningún token en el archivo.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:8000" },
    { "key": "token", "value": "" },
    { "key": "correlation_id", "value": "practica-32-caso" }
  ],
  "item": [
    {
      "name": "01 - Creada: consumidor inscripciones",
      "request": { "method": "POST", "header": [{"key":"Authorization","value":"Bearer {{token}}"},{"key":"Content-Type","value":"application/json"},{"key":"X-Correlation-ID","value":"{{correlation_id}}-01"}], "body": {"mode":"raw","raw":"{\n  \"id\": \"11111111-1111-4111-8111-111111111111\",\n  \"type\": \"enrollment.created\",\n  \"priority\": \"normal\",\n  \"data\": {\n    \"enrollment_id\": \"22222222-2222-4222-8222-222222222222\",\n    \"course_slug\": \"prompting-para-docentes\"\n  }\n}","options":{"raw":{"language":"json"}}}, "url":"{{base_url}}/api/enrollment-events"},
      "event": [{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('HTTP 200 y consumidor de inscripciones', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().destination).to.eql('inscripciones'); pm.expect(pm.response.json().status).to.eql('consumido'); });"]}}]
    },
    {
      "name": "02 - Actualizada: consumidor actualizaciones",
      "request": { "method": "POST", "header": [{"key":"Authorization","value":"Bearer {{token}}"},{"key":"Content-Type","value":"application/json"},{"key":"X-Correlation-ID","value":"{{correlation_id}}-02"}], "body": {"mode":"raw","raw":"{\n  \"id\": \"11111111-1111-4111-8111-111111111111\",\n  \"type\": \"enrollment.updated\",\n  \"priority\": \"normal\",\n  \"data\": {\n    \"enrollment_id\": \"22222222-2222-4222-8222-222222222222\",\n    \"course_slug\": \"prompting-para-docentes\"\n  }\n}","options":{"raw":{"language":"json"}}}, "url":"{{base_url}}/api/enrollment-events"},
      "event": [{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('HTTP 200 y consumidor de actualizaciones', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().destination).to.eql('actualizaciones'); pm.expect(pm.response.json().status).to.eql('consumido'); });"]}}]
    },
    {
      "name": "03 - Cancelada: consumidor cancelaciones",
      "request": { "method": "POST", "header": [{"key":"Authorization","value":"Bearer {{token}}"},{"key":"Content-Type","value":"application/json"},{"key":"X-Correlation-ID","value":"{{correlation_id}}-03"}], "body": {"mode":"raw","raw":"{\n  \"id\": \"11111111-1111-4111-8111-111111111111\",\n  \"type\": \"enrollment.cancelled\",\n  \"priority\": \"normal\",\n  \"data\": {\n    \"enrollment_id\": \"22222222-2222-4222-8222-222222222222\",\n    \"course_slug\": \"prompting-para-docentes\"\n  }\n}","options":{"raw":{"language":"json"}}}, "url":"{{base_url}}/api/enrollment-events"},
      "event": [{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('HTTP 200 y consumidor de cancelaciones', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().destination).to.eql('cancelaciones'); pm.expect(pm.response.json().status).to.eql('consumido'); });"]}}]
    },
    {
      "name": "04 - Tipo desconocido: no_enrutables",
      "request": { "method": "POST", "header": [{"key":"Authorization","value":"Bearer {{token}}"},{"key":"Content-Type","value":"application/json"},{"key":"X-Correlation-ID","value":"{{correlation_id}}-04"}], "body": {"mode":"raw","raw":"{\n  \"id\": \"11111111-1111-4111-8111-111111111111\",\n  \"type\": \"enrollment.archived\",\n  \"priority\": \"normal\",\n  \"data\": {\n    \"enrollment_id\": \"22222222-2222-4222-8222-222222222222\",\n    \"course_slug\": \"prompting-para-docentes\"\n  }\n}","options":{"raw":{"language":"json"}}}, "url":"{{base_url}}/api/enrollment-events"},
      "event": [{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('HTTP 202 y tipo no descartado', () => { pm.response.to.have.status(202); pm.expect(pm.response.json().destination).to.eql('no_enrutables'); pm.expect(pm.response.json().status).to.eql('no_enrutable'); });"]}}]
    },
    {
      "name": "05 - Prioridad baja: filtrado",
      "request": { "method": "POST", "header": [{"key":"Authorization","value":"Bearer {{token}}"},{"key":"Content-Type","value":"application/json"},{"key":"X-Correlation-ID","value":"{{correlation_id}}-05"}], "body": {"mode":"raw","raw":"{\n  \"id\": \"11111111-1111-4111-8111-111111111111\",\n  \"type\": \"enrollment.created\",\n  \"priority\": \"baja\",\n  \"data\": {\n    \"enrollment_id\": \"22222222-2222-4222-8222-222222222222\",\n    \"course_slug\": \"prompting-para-docentes\"\n  }\n}","options":{"raw":{"language":"json"}}}, "url":"{{base_url}}/api/enrollment-events"},
      "event": [{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('HTTP 200 pero no ejecuta consumidor', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().destination).to.eql('inscripciones'); pm.expect(pm.response.json().status).to.eql('filtrado'); });"]}}]
    },
    {
      "name": "06 - Sin campo obligatorio: validación 422",
      "request": { "method": "POST", "header": [{"key":"Authorization","value":"Bearer {{token}}"},{"key":"Content-Type","value":"application/json"},{"key":"X-Correlation-ID","value":"{{correlation_id}}-06"}], "body": {"mode":"raw","raw":"{\n  \"id\": \"11111111-1111-4111-8111-111111111111\",\n  \"type\": \"enrollment.created\",\n  \"priority\": \"normal\",\n  \"data\": {\n    \"enrollment_id\": \"22222222-2222-4222-8222-222222222222\"\n  }\n}","options":{"raw":{"language":"json"}}}, "url":"{{base_url}}/api/enrollment-events"},
      "event": [{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('HTTP 422 con campo faltante', () => { pm.response.to.have.status(422); pm.expect(pm.response.json().errors['data.course_slug']).to.be.an('array'); });"]}}]
    }
  ]
}
